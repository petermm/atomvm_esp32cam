[
    %% ESP32 Camera test configuration
    {esp32cam, [
        %% Enable test mode for all tests
        {test_mode, true},
        
        %% Mock configuration
        {mock_enabled, true},
        {mock_image_size, 1024},
        
        %% Test timeouts
        {test_timeout, 30000},
        {capture_timeout, 5000},
        
        %% Default test board
        {default_test_board, ai_thinker},
        
        %% Performance test settings
        {performance_iterations, 100},
        {performance_timeout, 60000}
    ]},
    
    %% Kernel configuration for testing
    {kernel, [
        {logger_level, info},
        {logger, [
            {handler, default, logger_std_h, #{
                config => #{file => "_build/test/logs/test.log"},
                formatter => {logger_formatter, #{
                    single_line => true,
                    time_designator => $\s
                }}
            }}
        ]}
    ]},
    
    %% SASL configuration for testing
    {sasl, [
        {sasl_error_logger, {file, "_build/test/logs/sasl.log"}}
    ]}
].