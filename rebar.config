{erl_opts, [debug_info, warnings_as_errors, warn_export_all, warn_unused_import]}.
{deps, []}.
{project_plugins, [
    atomvm_rebar3_plugin,
    erlfmt,
    rebar3_proper,
    rebar3_ex_doc
]}.

{ex_doc, [
    {extras, [
        {<<"README.md">>, #{title => <<"Overview">>}},
        {<<"markdown/board_support.md">>, #{title => <<"Supported Boards">>}},
        {<<"markdown/configuration.md">>, #{title => <<"Configuration Reference">>}},
        {<<"markdown/examples.md">>, #{title => <<"Examples & Recipes">>}},
        {<<"markdown/installer.md">>, #{title => <<"Web Installer">>}},
        {<<"markdown/troubleshooting.md">>, #{title => <<"Troubleshooting">>}},
        {<<"LICENSE">>, #{title => <<"License">>}}
    ]},
    {main, <<"README.md">>},
    {source_url, <<"https://github.com/atomvm/atomvm_esp32cam">>},
    {homepage_url, <<"https://github.com/atomvm/atomvm_esp32cam">>},
    {with_mermaid, true},
    {prefix_ref_vsn_with_v, false},
    {groups_for_extras, [
        {<<"Guides">>, [
            <<"markdown/board_support.md">>,
            <<"markdown/configuration.md">>,
            <<"markdown/examples.md">>,
            <<"markdown/installer.md">>,
            <<"markdown/troubleshooting.md">>
        ]}
    ]},
    {groups_for_modules, [
        {<<"Core Driver">>, [esp32cam]},
        {<<"Utilities">>, [camera_scanner, term_image]},
        {<<"Testing & Mocks">>, [esp32cam_mock]}
    ]}
]}.

%% EUnit configuration
{eunit_opts, [
    {report, {eunit_surefire, [{dir, "_build/test/logs"}]}}
]}.

%% Common Test configuration
{ct_opts, [
    {sys_config, "config/test.config"},
    {logdir, "_build/test/logs"}
]}.

%% Test paths
{eunit_compile_opts, [{i, "test"}]}.
{ct_compile_opts, [{i, "test"}]}.
%% Coverage configuration
{cover_enabled, true}.
{cover_opts, []}.

%% Dialyzer configuration
{dialyzer, [
    {warnings, [
        unknown,
        no_return,
        error_handling,
        missing_return,
        extra_return
    ]},
    {plt_apps, top_level_deps},
    {plt_extra_apps, []},
    {plt_location, local},
    {base_plt_apps, [stdlib, kernel]}
]}.

%% Profiles
{profiles, [
    {test, [
        {erl_opts, [debug_info, export_all, nowarn_export_all]},
        {extra_src_dirs, ["test"]},
        {deps, [
            {proper, "1.4.0"}
        ]}
    ]}
]}.

{erlfmt, [write]}.
